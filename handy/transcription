#!/usr/bin/env python3
import json
import os
import socket
import sys
from pathlib import Path

SOCKET = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "voz-codex/control.sock"
text = sys.stdin.read().rstrip("\n")
if not text:
    raise SystemExit(0)
with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
    sock.settimeout(120)
    sock.connect(str(SOCKET))
    sock.sendall(json.dumps({"command": "ingest", "text": text}).encode())
    sock.recv(131072)
